{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edukasi-bangsa",
  "main": "worker.js",
  "compatibility_date": "2026-08-29",

  "services": [
    {
      "binding": "VIDEO_API",
      "service": "edukasi-bangsa-api"
    }
  ],

  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/sitemap.xml"
    ]
  }
}
